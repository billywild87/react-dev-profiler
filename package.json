{
  "name": "react-dev-profiler",
  "version": "1.0.0",
  "description": "Real-time React performance monitoring — frame times, FPS, DOM mutations, memory, and more. Zero overhead in production.",
  "author": "Frederic Denis <billywild87@users.noreply.github.com> (https://github.com/billywild87)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/billywild87/react-dev-profiler.git"
  },
  "homepage": "https://github.com/billywild87/react-dev-profiler#readme",
  "bugs": {
    "url": "https://github.com/billywild87/react-dev-profiler/issues"
  },
  "keywords": [
    "react",
    "profiler",
    "performance",
    "devtools",
    "fps",
    "frame-time",
    "dom",
    "memory",
    "monitoring",
    "development"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^28.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.0.18"
  }
}
